{
  "name": "ashfall-dynasty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ashfall Dynasty — 5x3, 243-ways video slot. Dark medieval dragon-dynasty theme.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "sim": "tsx scripts/sim.ts",
    "rtp:exact": "tsx scripts/exact-rtp.ts",
    "strips:gen": "tsx scripts/strip-gen.ts",
    "golden:update": "tsx scripts/update-golden.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
